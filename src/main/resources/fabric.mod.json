{
	"schemaVersion": 1,
	"id": "workshop_zone",
	"version": "${version}",
	"name": "Workshop Zone",
	"description": "Connect nearby containers and workstations into one responsive workshop with quick switching, smart container labels, one-click deposit, inventory search, container highlighting, and warehouse-assisted crafting.",
	"authors": [
		"寿云"
	],
	"contact": {
		"homepage": "https://github.com/ikunkk02-afk/Workshop-Zone",
		"sources": "https://github.com/ikunkk02-afk/Workshop-Zone",
		"issues": "https://github.com/ikunkk02-afk/Workshop-Zone/issues"
	},
	"license": "MIT",
	"icon": "assets/workshop_zone/icon.png",
	"environment": "*",
	"mixins": [
		"workshop_zone.mixins.json"
	],
	"entrypoints": {
		"main": [
			"io.github.ikunkk02afk.workshopzone.WorkshopZone"
		],
		"client": [
			"io.github.ikunkk02afk.workshopzone.client.WorkshopZoneClient"
		],
		"jei_mod_plugin": [
			"io.github.ikunkk02afk.workshopzone.client.compat.jei.WorkshopZoneJeiPlugin"
		],
		"rei_client": [
			"io.github.ikunkk02afk.workshopzone.client.compat.rei.WorkshopZoneReiClientPlugin"
		],
		"fabric-datagen": [
			"io.github.ikunkk02afk.workshopzone.client.WorkshopZoneDataGenerator"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": ">=0.116.15+1.21.1"
	},
	"suggests": {
		"jei": "*",
		"emi": "*",
		"roughlyenoughitems": "*"
	}
}
